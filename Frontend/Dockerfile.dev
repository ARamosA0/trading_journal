# syntax=docker/dockerfile:1

FROM node:22.23.4-alpine3.24

LABEL org.opencontainers.image.source="https://github.com/ARamosA0/trading_journal"

WORKDIR /app

RUN mkdir -p /app/node_modules /home/node/.npm \
    && chown -R node:node /app /home/node/.npm

USER node

ENV npm_config_cache=/home/node/.npm

EXPOSE 5173

CMD ["sh", "-c", "npm ci && exec npm run dev -- --host 0.0.0.0"]
