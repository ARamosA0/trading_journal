# Copy to .env and fill in the required local values before running Docker Compose.
# Start development with: docker compose --profile development up --build
# Start the production-like local stack with: docker compose --profile production up --build
POSTGRES_DB=app_db
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional Google Identity Services client ID (public identifier, not a secret).
GOOGLE_CLIENT_ID=

# Optional SMTP delivery for password recovery.
AUTH_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tradevault.example
SMTP_AUTH=true
SMTP_STARTTLS=true

AUTH_COOKIE_SECURE=false
PASSWORD_RESET_URL=http://localhost:3000/reset-password
