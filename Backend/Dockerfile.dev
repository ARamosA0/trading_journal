# syntax=docker/dockerfile:1

FROM maven:3.9.9-eclipse-temurin-21-noble

LABEL org.opencontainers.image.source="https://github.com/ARamosA0/trading_journal"

WORKDIR /app

RUN mkdir -p /home/ubuntu/.m2 /app \
    && chown -R 1000:1000 /home/ubuntu /app

ENV MAVEN_CONFIG=/home/ubuntu/.m2

USER 1000:1000

EXPOSE 8080

CMD ["mvn", "--no-transfer-progress", "spring-boot:run"]
